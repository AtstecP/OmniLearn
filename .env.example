# These values work with local Docker Compose. To switch to hosted PostgreSQL,
# replace DATABASE_URL with your provider connection URI (URL-encode special characters).
DATABASE_URL=postgresql+psycopg://omnilearn:omnilearn-local-only@db:5432/omnilearn
POSTGRES_PASSWORD=omnilearn-local-only
CORS_ORIGINS=http://localhost:3000
# Origin the web app proxies /api/* to (inside Compose this is the api service).
API_ORIGIN=http://api:8000
COOKIE_SECURE=false
JWT_SECRET=local-development-only-change-before-deploying-123456
